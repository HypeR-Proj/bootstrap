    depends on BOOT_APP_CONSOLE_RAW
    help
        Build and deploy hyper-fs-backend at /svc/fs-backend.

config BOOT_APP_FS_EROFS
    bool "fs-erofs (/svc/fs-erofs)"
    default y
    depends on BOOT_APP_FS_BACKEND
    help
        Build and deploy hyper-fs-erofs at /svc/fs-erofs.

config BOOT_APP_FS_FAT
    bool "fs-fat (/svc/fs-fat)"
    default y
    depends on BOOT_APP_FS_BACKEND
    help
        Build and deploy hyper-fs-fat at /svc/fs-fat.

config BOOT_APP_INIT
    bool "init (/init)"
    default y
    help
        Build and deploy hyper-bootstrap-stage1-init at /init.

config BOOT_APP_IO_RUNTIME
    bool "io-runtime (/svc/io-runtime)"
    default y
    depends on BOOT_APP_CONSOLE_RAW
    help
        Build and deploy hyper-io-runtime at /svc/io-runtime.

config BOOT_APP_MOUNT
