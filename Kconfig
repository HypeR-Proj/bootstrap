menu "Bootstrap stage1"

config BOOT_APP_CONSOLE_RAW
    bool "console-raw (/svc/console-raw)"
    default y
    depends on BOOT_APP_INIT
    help
        Build and deploy hyper-console-raw at /svc/console-raw.

