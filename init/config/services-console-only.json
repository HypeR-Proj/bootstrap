{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "format": "hyper.service-manifest",
  "services": [
    {
      "name": "console-raw",
      "image": "/svc/console-raw",
      "critical": true,
      "restart": "never",
      "after": [],
      "loader": "bootstrap",
      "capabilities": [
        {
          "source": "bootstrap.console",
          "purpose": "console.system",
          "operation": "duplicate",
          "rights": [
            "wait",
            "read",
            "write"
          ]
        },
        {
          "source": "bootstrap.console-control-server",
          "purpose": "console.control",
          "operation": "move",
          "rights": [
            "wait",
            "read"
          ]
        },
        {
          "source": "bootstrap.console-log-server",
          "purpose": "console.logs",
          "operation": "move",
          "rights": [
            "wait",
            "read"
          ]
        }
      ]
    },
    {
      "name": "session-manager",
      "image": "/svc/session-manager",
      "critical": true,
      "restart": "never",
      "after": [
        "console-raw"
      ],
      "capabilities": [
        {
          "source": "bootstrap.service-output-channel",
          "purpose": "stdio.output",
          "operation": "duplicate",
          "rights": [
            "wait",
            "write",
            "duplicate",
            "transfer"
          ]
        },
        {
          "source": "bootstrap.service-output-channel",
          "purpose": "stdio.error",
          "operation": "duplicate",
          "rights": [
            "wait",
            "write",
            "duplicate",
            "transfer"
          ]
        },
        {
          "source": "bootstrap.root-directory",
          "purpose": "process.root-directory",
          "operation": "duplicate",
          "rights": [
            "read",
            "duplicate",
            "transfer",
            "execute",
            "protect",
            "write",
            "inspect",
            "set-attributes",
            "lock-file"
          ]
        },
        {
          "source": "bootstrap.task-factory",
          "purpose": "process.task-factory",
          "operation": "duplicate",
          "rights": [
            "create-process",
            "duplicate",
            "transfer",
            "create-task-group",
            "retain-process"
          ]
        },
        {
          "source": "bootstrap.task-group",
          "purpose": "process.task-group",
          "operation": "duplicate",
          "rights": [
            "attach-process",
            "duplicate",
            "transfer"
          ]
        },
        {
          "source": "bootstrap.resource-domain",
          "purpose": "process.resource-domain",
          "operation": "duplicate",
          "rights": [
            "sponsor",
            "duplicate",
            "transfer"
          ]
        },
        {
          "source": "bootstrap.task-inspector",
          "purpose": "process.task-inspector",
          "operation": "duplicate",
          "rights": [
            "duplicate",
            "transfer",
            "inspect"
          ]
        },
        {
          "source": "bootstrap.object-inspector",
          "purpose": "process.object-inspector",
          "operation": "duplicate",
          "rights": [
            "duplicate",
            "transfer",
            "inspect",
            "inspect-details"
          ]
        },
        {
          "source": "bootstrap.memory-inspector",
          "purpose": "process.memory-inspector",
          "operation": "duplicate",
          "rights": [
            "duplicate",
            "transfer",
            "inspect"
          ]
        },
        {
          "source": "bootstrap.cpu-inspector",
          "purpose": "process.cpu-inspector",
          "operation": "duplicate",
          "rights": [
            "duplicate",
            "transfer",
            "inspect",
            "set-attributes",
            "inspect-details"
          ]
        },
        {
          "source": "bootstrap.dynamic-library-directory",
          "purpose": "process.child-library-directory",
          "operation": "duplicate",
          "rights": [
            "read",
            "execute",
            "protect",
            "duplicate",
            "transfer"
          ]
        },
        {
          "source": "bootstrap.child-loader",
          "purpose": "process.child-loader",
          "operation": "duplicate",
          "rights": [
            "read",
            "execute",
            "duplicate",
            "transfer"
          ]
        },
        {
          "source": "bootstrap.environment-directory",
          "purpose": "process.environment-directory",
          "rights": [
            "read",
            "inspect",
            "execute",
            "protect",
            "duplicate",
            "transfer"
          ],
          "operation": "duplicate"
        },
        {
          "source": "bootstrap.console-controller",
          "purpose": "session.console-controller",
          "operation": "duplicate",
          "rights": [
            "wait",
            "write",
            "duplicate",
            "transfer"
          ]
        },
        {
          "source": "bootstrap.console-log-connector",
          "purpose": "session.log-connector",
          "operation": "duplicate",
          "rights": [
            "wait",
            "write",
            "duplicate",
            "transfer"
          ]
        }
      ],
      "loader": "dynamic"
    }
  ]
}
